# Yaalu Dating App - Production & Development Environment Config
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Secret Keys (Generate with `openssl rand -hex 64` in production)
JWT_ACCESS_SECRET=yaalu_super_secure_jwt_access_secret_production_ready_99238472918374
JWT_REFRESH_SECRET=yaalu_super_secure_jwt_refresh_secret_production_ready_10293847562
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://10.0.2.2:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200 # Max requests per window per IP
AUTH_RATE_LIMIT_MAX=10 # Max auth attempts per 15 minutes

# PayHere Sri Lanka Payment Gateway Configuration
PAYHERE_MERCHANT_ID=1220001
PAYHERE_SECRET=yaalu_payhere_secret_hash_token_sample
PAYHERE_ENV=sandbox # sandbox or live

# Database Connection (PostgreSQL with PostGIS / MongoDB)
DATABASE_URL=postgresql://yaalu_user:secure_password@localhost:5432/yaalu_db?sslmode=prefer

# Redis (Session & Geo Cache)
REDIS_URL=redis://localhost:6379

# Storage Configuration (AWS S3 or Local Uploads)
UPLOAD_STORAGE_TYPE=local # 'local' or 's3'
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=yaalu-media-storage

# ========================================================
# 🔥 FIREBASE PHONE AUTH & SMS GATEWAY CREDENTIALS
# ========================================================
# 1. Enable Firebase Real SMS
FIREBASE_ENABLED=false # Set to 'true' in production

# 2. Firebase Project & Service Account (Get from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Firebase Web API Key (For Google Identity Toolkit REST API SMS)
# Get from Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_WEB_API_KEY=AIzaSyYourFirebaseWebApiKeyHere

# 4. Gateway Provider: 'mock' (dev 777777), 'firebase', 'dialog', or 'twilio'
SMS_GATEWAY_PROVIDER=mock
SMS_SENDER_ID=Yaalu
